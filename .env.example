TASKFORGE_ENVIRONMENT=local
TASKFORGE_LOG_LEVEL=INFO
TASKFORGE_STORAGE_BACKEND=postgres
TASKFORGE_DATABASE_URL=postgresql+psycopg://taskforge:taskforge_dev_password@127.0.0.1:5433/taskforge
TASKFORGE_DATABASE_POOL_SIZE=5
TASKFORGE_DATABASE_MAX_OVERFLOW=0
TASKFORGE_DATABASE_POOL_TIMEOUT_SECONDS=5
TASKFORGE_SESSION_TTL_MINUTES=60
TASKFORGE_SESSION_COOKIE_NAME=taskforge_session
TASKFORGE_CSRF_HEADER_NAME=X-CSRF-Token
TASKFORGE_SESSION_COOKIE_SECURE=false

